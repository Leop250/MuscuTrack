# Copier ce fichier vers .env, puis remplacer les valeurs "change-me".
# Le fichier .env n'est jamais versionné.

# Base de données
POSTGRES_USER=muscutrack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=muscutrack
POSTGRES_HOST=db
POSTGRES_PORT=5432

# JWT : clé partagée entre auth-service et tracking-service
# Générer une valeur avec : openssl rand -hex 32
JWT_SECRET=change-me

# Adresses des services : on utilise leur nom, pas localhost
AUTH_SERVICE_URL=http://auth-service:8000
TRACKING_SERVICE_URL=http://tracking-service:8000
